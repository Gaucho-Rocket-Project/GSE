# ---------------------------------------------------------------------------
# sdkconfig.defaults.uart - alternative console on UART0 (the COM port)
#
# Use this if the USB port on your board is not the native USB-Serial-JTAG
# (e.g. a board with a CH340/CP210x USB-UART bridge only, or you want the
# console on the normal serial pins GPIO43/GPIO44 @ 115200).
#
#   make build-uart     # builds into build-uart/ using this file
# ---------------------------------------------------------------------------

CONFIG_IDF_TARGET="esp32s3"

CONFIG_ESP_CONSOLE_UART=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_ESP_CONSOLE_UART_NUM=0

CONFIG_NEWLIB_STDOUT_LINE_ENDING_CRLF=y
CONFIG_NEWLIB_STDIN_LINE_ENDING_LF=y

CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
# (ccache is enabled from the environment: export IDF_CCACHE_ENABLE=1)

# --- Size ----------------------------------------------------------------
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# --- Servo type ----------------------------------------------------------
# Passed to the compiler by main/CMakeLists.txt (-DSERVO_TYPE=...).
#   1 = SG90 / micro analog  (default)
#   2 = DS3225MG 25 kg digital
# Override per build, e.g.:  make build SERVO_TYPE=2 SERVO_TRAVEL_DEG=180
